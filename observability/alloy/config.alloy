loki.source.file "allcll" {
  tail_from_end           = true
  targets = [
    {
      "__path__"    = "/var/log/allcll/spring-boot-application-error.log",
      "application" = "backend",
      "env"         = "prod",
      "level"       = "error",
    },
    {
      "__path__"    = "/var/log/allcll/spring-boot-application-info.log",
      "application" = "backend",
      "env"         = "prod",
      "level"       = "info",
    },
  ]
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
